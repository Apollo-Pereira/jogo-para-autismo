code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_5;



void fragment() {
// Input:6
	float n_out6p0 = TIME;


// UVFunc:4
	vec2 n_in4p1 = vec2(0.00100, 0.00100);
	vec2 n_out4p0 = vec2(n_out6p0) * n_in4p1 + UV;


// UVFunc:7
	vec2 n_in7p1 = vec2(2.00000, 2.00000);
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (n_out4p0 - n_in7p2) * n_in7p1 + n_in7p2;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out7p0);


// Input:9
	float n_out9p0 = TIME;


// UVFunc:10
	vec2 n_in10p1 = vec2(-0.00100, 0.00100);
	vec2 n_out10p0 = vec2(n_out9p0) * n_in10p1 + UV;


// UVFunc:11
	vec2 n_in11p1 = vec2(2.00000, 2.00000);
	vec2 n_in11p2 = vec2(0.00000, 0.00000);
	vec2 n_out11p0 = (n_out10p0 - n_in11p2) * n_in11p1 + n_in11p2;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out11p0);


// VectorOp:8
	vec4 n_out8p0 = n_out2p0 * n_out5p0;


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out8p0.x;


}
